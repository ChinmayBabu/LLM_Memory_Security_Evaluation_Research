# Local model and embedding configuration
MABENCH_LLM_MODEL=qwen2.5:1.5b-instruct
MABENCH_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
MABENCH_HF_LOCAL_FILES_ONLY=true
OLLAMA_BASE_URL=http://127.0.0.1:11434
MEM0_TELEMETRY=false

# Self-hosted Letta service (used by scripts/phase1_letta.py)
LETTA_BASE_URL=http://127.0.0.1:8283
LETTA_MODEL=ollama/qwen2.5:1.5b-instruct
LETTA_EMBEDDING_MODEL=ollama/nomic-embed-text:latest
MABENCH_OLLAMA_URL=http://127.0.0.1:11434
MABENCH_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
MABENCH_HF_LOCAL_FILES_ONLY=true
LETTA_CONTEXT_WINDOW=2048

# Chroma when the benchmark runs on the host
CHROMA_HOST=127.0.0.1
CHROMA_PORT=8000
# Set this to a local path, such as .mabench/chroma, when Docker memory
# competes with the local Ollama model during development.
# CHROMA_PATH=.mabench/chroma

# Reproducibility defaults
MABENCH_SEED=20260820
MABENCH_REPEATS=5
MABENCH_RUNS_DIR=results
